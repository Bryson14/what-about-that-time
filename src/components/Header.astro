---
import Header from "./Header.svelte";

export interface Props {
  session: { fullName: string; username: string };
  isAdmin: boolean;
  title?: string;
  titleHref?: string;
  navLinks?: { href: string; label: string }[];
  variant?: "light" | "dark";
}

const { session, isAdmin, title, titleHref, navLinks, variant } = Astro.props;
---

<Header
  session={session}
  isAdmin={isAdmin}
  title={title}
  titleHref={titleHref}
  navLinks={navLinks ?? []}
  variant={variant ?? "light"}
  client:load
/>
