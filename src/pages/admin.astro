---
import { getSessionFromRequest, isAdminUser, listUsers } from "../lib/auth";
import { logger } from "../lib/logging";
import type { UserSummary } from "../lib/auth";
import AdminShell from "../components/AdminShell.svelte";

const session = await getSessionFromRequest(Astro.request);
if (!session) {
  return Astro.redirect("/login");
}

if (!isAdminUser(session)) {
  return Astro.redirect("/app");
}

let users: UserSummary[] = [];
try {
  users = await listUsers();
} catch (err) {
  logger.error("failed to load user list for admin dashboard", { username: session.username, error: String(err) });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Admin dashboard for managing users and access to the personal timeline." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>Admin · What About That Time</title>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: system-ui, sans-serif;
        background: #fafafa;
        color: #1a1a1a;
      }
    </style>
  </head>
  <body>
    <AdminShell
      session={{ fullName: session.fullName, username: session.username }}
      users={users}
      client:load
    />
  </body>
</html>
