---
import { getSessionFromRequest, isAdminUser, listUsers } from "../lib/auth";
import { logger } from "../lib/logging";
import type { UserSummary } from "../lib/auth";
import { ALL_GROUPS } from "../lib/validation";
import Header from "../components/Header.astro";

const session = await getSessionFromRequest(Astro.request);
if (!session) {
  return Astro.redirect("/login");
}

if (!isAdminUser(session)) {
  return Astro.redirect("/app");
}

let users: UserSummary[] = [];
try {
  users = await listUsers();
} catch (err) {
  logger.error("failed to load user list for admin dashboard", { username: session.username, error: String(err) });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Admin · What About That Time</title>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: system-ui, sans-serif;
        padding: 1rem;
        background: #fafafa;
        color: #1a1a1a;
      }
      .wrap { max-width: 900px; margin: 0 auto; }
      .card {
        background: #fff;
        border-radius: 8px;
        box-shadow: 0 1px 3px rgba(0,0,0,.1);
        padding: 1rem;
        margin-bottom: 1rem;
      }
      .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: .75rem;
        margin-bottom: .75rem;
      }
      .field { display: flex; flex-direction: column; gap: .35rem; }
      .field label { font-size: .8rem; font-weight: 600; color: #555; }
      .field input {
        padding: .55rem .65rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font: inherit;
      }
      .save-btn {
        padding: .55rem .9rem;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font: inherit;
      }
      .save-btn:hover { background: #333; }
      table { width: 100%; border-collapse: collapse; }
      th, td { text-align: left; padding: .65rem; border-bottom: 1px solid #eee; font-size: .9rem; }
      th { background: #f0f0f0; }
      .delete-btn {
        border: 1px solid #f1d1d1;
        background: #fff;
        color: #b10000;
        border-radius: 6px;
        padding: .35rem .55rem;
        cursor: pointer;
      }
      .delete-btn:hover { background: #fff1f1; }
      .edit-btn {
        border: 1px solid #d0d0d0;
        background: #fff;
        color: #333;
        border-radius: 6px;
        padding: .35rem .55rem;
        cursor: pointer;
        margin-right: .25rem;
      }
      .edit-btn:hover { background: #f0f0f0; }
      .muted { color: #777; font-size: .9rem; }
      .error {
        color: #a10000;
        font-size: .9rem;
        margin-top: .5rem;
        min-height: 1.2rem;
      }
      .group-chip {
        display: inline-block;
        border: 1px solid #e0e0e0;
        border-radius: 999px;
        padding: .15rem .55rem;
        font-size: .8rem;
        margin: .1rem .15rem .1rem 0;
        background: #f8f8f8;
        color: #444;
      }
      .group-edit-row { display: none; align-items: center; gap: .35rem; }
      .group-edit-row input {
        padding: .35rem .5rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        font: inherit;
        font-size: .85rem;
        width: 180px;
      }
      .group-edit-row.active { display: flex; }
      .group-display-row.hidden { display: none; }
      .group-save-btn {
        padding: .35rem .6rem;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font: inherit;
        font-size: .8rem;
      }
      .group-cancel-btn {
        padding: .35rem .6rem;
        background: none;
        border: 1px solid #ccc;
        border-radius: 4px;
        cursor: pointer;
        font: inherit;
        font-size: .8rem;
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <Header
        session={{ fullName: session.fullName, username: session.username }}
        isAdmin={true}
        title="Admin Dashboard"
        navLinks={[
          { href: "/app", label: "Back to app" },
          { href: "/timeline", label: "Timeline" },
        ]}
      />

      <div class="card">
        <h2 style="font-size:1.1rem;margin-bottom:.75rem;">Add user</h2>
        <form id="add-user-form">
          <div class="form-grid">
            <div class="field">
              <label for="username">Username</label>
              <input id="username" name="username" required />
            </div>
            <div class="field">
              <label for="fullName">Full name</label>
              <input id="fullName" name="fullName" required />
            </div>
            <div class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" required minlength="8" maxlength="128" />
            </div>
            <div class="field">
              <label for="allowedGroups">Allowed group</label>
              <input id="allowedGroups" list="group-list" name="allowedGroups" />
              <datalist id="group-list">
                {ALL_GROUPS.map(group => <option value={group} />)}
              </datalist>
            </div>
          </div>
          <button class="save-btn" type="submit">Create user</button>
          <p id="form-error" class="error"></p>
        </form>
      </div>

      <div class="card">
        <h2 style="font-size:1.1rem;margin-bottom:.25rem;">Contributors</h2>
        <p class="muted" style="margin-bottom:.75rem;">Admin users cannot be removed.</p>
        <table>
          <thead>
            <tr>
              <th>Username</th>
              <th>Full Name</th>
              <th>Allowed Groups</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="users-body">
            {users.map((user) => (
              <tr data-username={user.username}>
                <td><strong>@{user.username}</strong></td>
                <td>{user.fullName}</td>
                <td>
                  <div class="group-display-row" data-role={user.role}>
                    {user.allowedGroups?.map((g) => (
                      <span class="group-chip">{g}</span>
                    ))}
                  </div>
                  {user.role !== "admin" && (
                    <div class="group-edit-row">
                      <input type="text" value={user.allowedGroups?.join(", ")} data-username={user.username} class="group-edit-input" />
                      <button class="group-save-btn" type="button" data-username={user.username}>Save</button>
                      <button class="group-cancel-btn" type="button">Cancel</button>
                    </div>
                  )}
                </td>
                <td>
                  {user.role === "admin" ? (
                    <span class="muted">Owner</span>
                  ) : (
                    <>
                      <button class="edit-btn" data-username={user.username} type="button">Edit</button>
                      <button class="delete-btn" data-username={user.username} type="button">Remove</button>
                    </>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <script>
      import { errorResponseSchema } from "../lib/validation";
      const form = document.getElementById("add-user-form") as HTMLFormElement;
      const formError = document.getElementById("form-error") as HTMLElement;
      const usersBody = document.getElementById("users-body") as HTMLElement;

      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        formError.textContent = "";

        const data = new FormData(form);
        const groupsInput = String(data.get("allowedGroups") || "default").trim();
        const allowedGroups = groupsInput
          .split(",")
          .map((g) => g.trim())
          .filter((g) => g.length > 0);

        const body = {
          username: String(data.get("username") || ""),
          fullName: String(data.get("fullName") || ""),
          password: String(data.get("password") || ""),
          allowedGroups: allowedGroups.length > 0 ? allowedGroups : ["default"],
        };

        const response = await fetch("/api/admin/users", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });

        if (!response.ok) {
          try {
            const json = await response.json();
            const parsed = errorResponseSchema.safeParse(json);
            formError.textContent = parsed.success ? String(parsed.data.error) : "Unable to create user.";
          } catch {
            formError.textContent = "Unable to create user.";
          }
          return;
        }

        location.reload();
      });

      usersBody.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement;
        if (!(target instanceof HTMLElement)) return;

        if (target.classList.contains("delete-btn")) {
          const username = target.dataset.username;
          if (!username) return;
          if (!window.confirm(`Remove @${username}?`)) return;

          const response = await fetch(`/api/admin/users/${encodeURIComponent(username)}`, {
            method: "DELETE",
          });

          if (!response.ok) {
            let message = "Unable to remove user.";
            try {
              const json = await response.json();
              const parsed = errorResponseSchema.safeParse(json);
              message = parsed.success ? String(parsed.data.error) : message;
            } catch {}
            formError.textContent = message;
            return;
          }

          location.reload();
        }

        if (target.classList.contains("edit-btn")) {
          const username = target.dataset.username;
          if (!username) return;
          const row = target.closest("tr");
          if (!row) return;
          const displayRow = row.querySelector(".group-display-row") as HTMLElement;
          const editRow = row.querySelector(".group-edit-row") as HTMLElement;
          if (displayRow) displayRow.classList.add("hidden");
          if (editRow) editRow.classList.add("active");
        }

        if (target.classList.contains("group-cancel-btn")) {
          const row = target.closest("tr");
          if (!row) return;
          const displayRow = row.querySelector(".group-display-row") as HTMLElement;
          const editRow = row.querySelector(".group-edit-row") as HTMLElement;
          if (displayRow) displayRow.classList.remove("hidden");
          if (editRow) editRow.classList.remove("active");
        }

        if (target.classList.contains("group-save-btn")) {
          const username = target.dataset.username;
          if (!username) return;
          const row = target.closest("tr");
          if (!row) return;
          const input = row.querySelector(".group-edit-input") as HTMLInputElement;
          if (!input) return;

          const groupsInput = input.value.trim();
          const allowedGroups = groupsInput
            .split(",")
            .map((g) => g.trim())
            .filter((g) => g.length > 0);

          if (allowedGroups.length === 0) {
            formError.textContent = "At least one group is required.";
            return;
          }

          formError.textContent = "";
          const response = await fetch(`/api/admin/users/${encodeURIComponent(username)}`, {
            method: "PUT",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ allowedGroups }),
          });

          if (!response.ok) {
            let message = "Unable to update groups.";
            try {
              const json = await response.json();
              const parsed = errorResponseSchema.safeParse(json);
              message = parsed.success ? String(parsed.data.error) : message;
            } catch {}
            formError.textContent = message;
            return;
          }

          location.reload();
        }
      });
    </script>
  </body>
</html>
