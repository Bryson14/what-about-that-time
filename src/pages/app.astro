---
import { getSessionFromRequest, isAdminUser } from "../lib/auth";
import { logger } from "../lib/logging";
import { DEFAULT_PAGE_SIZE, MAX_PAGE_SIZE, MIN_PAGE_SIZE } from "../lib/validation";

const session = await getSessionFromRequest(Astro.request);
if (!session) {
  return Astro.redirect("/login");
}

import { getPaginatedEvents } from "../lib/db";
import type { Event } from "../lib/db";
import AppShell from "../components/AppShell.svelte";

const isAdmin = isAdminUser(session);

let events: Event[] = [];
let total = 0;
let currentPage = 1;
let pageSize = DEFAULT_PAGE_SIZE;
let search = "";

try {
  const url = new URL(Astro.request.url);
  const parsedPage = Number(url.searchParams.get("page"));
  currentPage = Number.isInteger(parsedPage) && parsedPage >= 1 ? parsedPage : 1;
  const parsedPageSize = Number(url.searchParams.get("pageSize"));
  pageSize = Number.isInteger(parsedPageSize) && parsedPageSize >= MIN_PAGE_SIZE && parsedPageSize <= MAX_PAGE_SIZE
    ? parsedPageSize
    : DEFAULT_PAGE_SIZE;
  search = url.searchParams.get("search") || "";
  const groups = isAdmin ? undefined : session.allowedGroups;
  const result = await getPaginatedEvents(currentPage, pageSize, search, groups);
  events = result.events;
  total = result.total;
} catch (err) {
  logger.error("failed to load events", { username: session.username, error: String(err) });
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Browse and manage your personal timeline events." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>What About That Time</title>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: system-ui, sans-serif;
        padding: .5rem;
        max-width: 100%;
        margin: 0 auto;
        background: #fafafa;
        color: #1a1a1a;
      }
      @media (min-width: 768px) {
        body { padding: 0; }
      }
    </style>
  </head>
  <body>
    <AppShell
      session={{ fullName: session.fullName, username: session.username }}
      isAdmin={isAdmin}
      initialEvents={events}
      initialTotal={total}
      initialPage={currentPage}
      pageSize={pageSize}
      initialSearch={search}
      userGroups={session.allowedGroups}
      client:load
    />
  </body>
</html>
