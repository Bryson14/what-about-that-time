---
import { getSessionFromRequest, isAdminUser } from "../lib/auth";
import { logger } from "../lib/logging";

const session = await getSessionFromRequest(Astro.request);
if (!session) {
  return Astro.redirect("/login");
}

import { getAllEvents } from "../lib/db";
import type { Event } from "../lib/db";
import EventsTable from "../components/EventsTable.astro";
import AddEventDialog from "../components/AddEventDialog.astro";
import Toast from "../components/Toast.astro";

let events: Event[] = [];
try {
  events = await getAllEvents();
} catch (err) {
  logger.error("failed to load events", { username: session.username, error: String(err) });
}

const isAdmin = isAdminUser(session);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>What About That Time</title>
    <style>
      * { box-sizing: border-box; margin: 0; }

      body {
        font-family: system-ui, sans-serif;
        padding: .5rem;
        max-width: 100%;
        margin: 0 auto;
        background: #fafafa;
        color: #1a1a1a;
      }

      h1 { margin-bottom: .5rem; }

      .content {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 0 4rem;
      }


      .header {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: .75rem;
        margin-bottom: 1rem;
      }
      .logout-btn {
        padding: .35rem .85rem; background: none; border: 1px solid #ccc;
        border-radius: 4px; cursor: pointer; font: inherit; font-size: .85rem; color: #555;
      }
      .logout-btn:hover { background: #f0f0f0; }

      .nav-btn {
        padding: .35rem .85rem; background: none; border: 1px solid #ccc;
        border-radius: 4px; font: inherit; font-size: .85rem; color: #555;
        text-decoration: none; display: inline-block;
      }
      .nav-btn:hover { background: #f0f0f0; }
      .user-chip {
        border: 1px solid #ddd;
        border-radius: 999px;
        padding: .3rem .75rem;
        font-size: .8rem;
        color: #555;
        background: #fff;
      }

      .add-fab {
        position: fixed;
        top: max(.85rem, env(safe-area-inset-top));
        right: max(.85rem, env(safe-area-inset-right));
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 999px;
        background: #1a1a1a;
        color: #fff;
        font-size: 1.8rem;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 10px 28px rgba(0,0,0,.28);
      }
      .add-fab:hover { background: #333; }

      @media (min-width: 768px) {
        body { padding: 2rem; }
        .content { padding: 0 1rem 4rem; }
        .header {
          flex-direction: row;
          justify-content: space-between;
          align-items: center;
          margin-bottom: 1.5rem;
        }
        .add-fab {
          top: 1.25rem;
          right: 1.25rem;
        }
      }

      @media (min-width: 1024px) {
        .content { padding: 0 2rem 4rem; }
      }
    </style>
  </head>
  <body>
    <button id="open-add" class="add-fab" type="button" aria-label="Add event">+</button>

    <div class="content">
      <div class="header">
        <h1>What About That Time</h1>
        <div style="display:flex;gap:.5rem;align-items:center">
          <span class="user-chip">{session.fullName} (@{session.username})</span>
          {isAdmin && <a href="/admin" class="nav-btn">Admin</a>}
          <a href="/timeline" class="nav-btn">Timeline view</a>
          <form method="POST" action="/api/logout" style="display:contents">
            <button class="logout-btn" type="submit">Sign out</button>
          </form>
        </div>
      </div>

      <EventsTable events={events} />
    </div>

    <AddEventDialog />
    <Toast />

    <script>
      const addDialog = document.getElementById("add-dialog") as HTMLDialogElement;
      const openAddButton = document.getElementById("open-add") as HTMLButtonElement;
      const closeDialogButton = document.getElementById("close-dialog") as HTMLButtonElement;
      const cancelDialogButton = document.getElementById("cancel-dialog") as HTMLButtonElement;
      const tableBody = document.querySelector("tbody") as HTMLTableSectionElement;
      const form = document.getElementById("event-form") as HTMLFormElement;
      const toast = document.getElementById("toast") as HTMLDivElement | null;

      function showToast(message: string, type: "success" | "error" = "success") {
        if (!toast) return;
        toast.textContent = message;
        toast.className = `toast ${type} show`;
        setTimeout(() => toast.classList.remove("show"), 3000);
      }

      function openAddDialog() {
        if (typeof addDialog.showModal !== "function") {
          showToast("Your browser does not support the dialog feature. Please use a modern browser.", "error");
          return;
        }
        addDialog.showModal();
      }

      function closeAddDialog() {
        if (typeof addDialog.close === "function") addDialog.close();
      }

      openAddButton.addEventListener("click", openAddDialog);
      closeDialogButton.addEventListener("click", closeAddDialog);
      cancelDialogButton.addEventListener("click", closeAddDialog);

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const body = Object.fromEntries(data.entries());

        const res = await fetch("/api/events", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });

        if (!res.ok) {
          const err = await res.json();
          showToast(err.error || "Failed to create event", "error");
          return;
        }

        closeAddDialog();
        location.reload();
      });

      function closeMenus() {
        document.querySelectorAll(".menu-panel").forEach((panel) => {
          panel.hidden = true;
        });
      }

      tableBody.addEventListener("click", async (e) => {
        const target = e.target as HTMLElement;

        if (target.classList.contains("menu-trigger")) {
          const panel = target.nextElementSibling as HTMLElement;
          const wasOpen = !panel.hidden;
          closeMenus();
          panel.hidden = wasOpen;
          return;
        }

        if (!target.classList.contains("delete")) return;
        const id = target.dataset.id;
        const eventTitle = target.closest("tr")?.querySelector("strong")?.textContent?.trim() || "this event";

        if (!window.confirm(`Delete "${eventTitle}"?`)) return;

        const res = await fetch(`/api/events/${id}`, { method: "DELETE" });
        if (!res.ok) {
          showToast("Failed to delete event", "error");
          return;
        }

        location.reload();
      });

      document.addEventListener("click", (e) => {
        if (!e.target.closest(".menu")) {
          closeMenus();
        }
      });
    </script>
  </div>
  </body>
</html>
