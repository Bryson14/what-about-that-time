---
import { DEMO_EVENTS, DEMO_GROUPS } from "../../lib/demo";
import AppShell from "../../components/AppShell.svelte";

export const prerender = true;

const pageSize = 10;
const initialEvents = DEMO_EVENTS.slice(0, pageSize);
const total = DEMO_EVENTS.length;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Try the demo of What About That Time — explore a sample timeline of events." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <title>Demo – What About That Time</title>
    <style>
      * { box-sizing: border-box; margin: 0; }
      body {
        font-family: system-ui, sans-serif;
        padding: .5rem;
        max-width: 100%;
        margin: 0 auto;
        background: #fafafa;
        color: #1a1a1a;
      }
      @media (min-width: 768px) {
        body { padding: 0; }
      }
    </style>
  </head>
  <body>
    <script is:inline define:vars={{ seedEvents: DEMO_EVENTS }}>
      window.__DEMO_SEED__ = seedEvents;
    </script>

    <AppShell
      session={{ fullName: "Demo User", username: "demo" }}
      isAdmin={true}
      initialEvents={initialEvents}
      initialTotal={total}
      initialPage={1}
      pageSize={pageSize}
      initialSearch=""
      userGroups={DEMO_GROUPS}
      demo={true}
      client:load
    />
  </body>
</html>
