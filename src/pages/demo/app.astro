---
import { DEMO_EVENTS, DEMO_GROUPS } from "../../lib/demo";
import type { Event } from "../../lib/db";
import EventsTable from "../../components/EventsTable.astro";
import AddEventDialog from "../../components/AddEventDialog.astro";
import Toast from "../../components/Toast.astro";

export const prerender = true;

const pageSize = 10;
const initialEvents: Event[] = DEMO_EVENTS.slice(0, pageSize);
const total = DEMO_EVENTS.length;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Demo – What About That Time</title>
    <style>
      * { box-sizing: border-box; margin: 0; }

      body {
        font-family: system-ui, sans-serif;
        padding: .5rem;
        max-width: 100%;
        margin: 0 auto;
        background: #fafafa;
        color: #1a1a1a;
      }

      .content {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 0 4rem;
      }

      .demo-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 0;
        gap: 0.5rem;
        margin-bottom: .75rem;
        flex-wrap: wrap;
      }

      .demo-title {
        font-weight: 600;
        font-size: 1.1rem;
        text-decoration: none;
        color: #1a1a1a;
        display: flex;
        align-items: center;
        gap: .4rem;
      }

      .demo-badge {
        font-size: .7rem;
        background: #e5e7eb;
        color: #555;
        padding: .15rem .5rem;
        border-radius: 999px;
        font-weight: 500;
      }

      .demo-nav {
        display: flex;
        gap: .35rem;
        align-items: center;
      }

      .demo-nav a {
        padding: .35rem .85rem;
        font-size: .85rem;
        border: 1px solid #ccc;
        border-radius: 4px;
        color: #555;
        text-decoration: none;
        transition: all .15s;
      }

      .demo-nav a:hover { background: #f0f0f0; }
      .demo-nav a.active { background: #1a1a1a; color: #fff; border-color: #1a1a1a; }

      .add-fab {
        position: fixed;
        bottom: max(1rem, env(safe-area-inset-bottom));
        right: max(1rem, env(safe-area-inset-right));
        width: 3rem;
        height: 3rem;
        border: none;
        border-radius: 999px;
        background: #1a1a1a;
        color: #fff;
        font-size: 1.8rem;
        line-height: 1;
        cursor: pointer;
        box-shadow: 0 10px 28px rgba(0,0,0,.28);
      }
      .add-fab:hover { background: #333; }

      @media (min-width: 768px) {
        body { padding: 2rem; }
        .content { padding: 0 1rem 4rem; }
        .add-fab {
          top: 1.25rem;
          right: 1.25rem;
          bottom: auto;
        }
      }

      @media (min-width: 1024px) {
        .content { padding: 0 2rem 4rem; }
      }
    </style>
  </head>
  <body>
    <button id="open-add" class="add-fab" type="button" aria-label="Add event">+</button>

    <div class="content">
      <div class="demo-header">
        <a href="/demo/app" class="demo-title">
          What About That Time <span class="demo-badge">Demo</span>
        </a>
        <nav class="demo-nav">
          <a href="/demo/app" class="active">List</a>
          <a href="/demo/timeline">Timeline</a>
        </nav>
      </div>

      <EventsTable
        events={initialEvents}
        total={total}
        page={1}
        pageSize={pageSize}
        search=""
        isAdmin={true}
        currentUsername="demo"
      />
    </div>

    <AddEventDialog isAdmin={true} userGroups={DEMO_GROUPS} />
    <Toast />
    <script is:inline define:vars={{ seedEvents: DEMO_EVENTS }}>
      window.__DEMO_SEED__ = seedEvents;
    </script>

    <script>
      import type { Event } from "../../lib/db";

      const STORAGE_KEY = "demo_events";
      const PAGE_SIZE = 10;

      function loadEvents(): Event[] {
        try {
          const raw = sessionStorage.getItem(STORAGE_KEY);
          if (raw) {
            const parsed = JSON.parse(raw);
            if (Array.isArray(parsed) && parsed.length > 0) return parsed;
          }
        } catch { /* ignore */ }
        // Seed from embedded data
        const seed = (window as any).__DEMO_SEED__;
        if (seed) {
          saveEvents(seed);
          return seed;
        }
        return [];
      }

      function saveEvents(events: Event[]) {
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(events));
      }

      let allEvents: Event[] = loadEvents();

      // ── App State ────────────────────────────────────────────
      const appState = {
        page: 1,
        search: "",
        eventsMap: new Map<number, Event>(),
      };

      // Build initial events map
      allEvents.forEach(ev => appState.eventsMap.set(ev.id, ev));

      // ── DOM refs ─────────────────────────────────────────────
      const addDialog = document.getElementById("add-dialog") as HTMLDialogElement;
      const openAddButton = document.getElementById("open-add") as HTMLButtonElement;
      const closeDialogButton = document.getElementById("close-dialog") as HTMLButtonElement;
      const cancelDialogButton = document.getElementById("cancel-dialog") as HTMLButtonElement;
      const form = document.getElementById("event-form") as HTMLFormElement;
      const toast = document.getElementById("toast") as HTMLDivElement | null;
      const searchInput = document.getElementById("table-search") as HTMLInputElement;
      const paginationContainer = document.querySelector(".pagination") as HTMLElement;
      const tbody = document.querySelector("tbody") as HTMLTableSectionElement;

      let searchTimer: ReturnType<typeof setTimeout>;
      let nextId = Math.max(...allEvents.map(e => e.id), 0) + 1;

      // ── Helpers ──────────────────────────────────────────────
      function escapeHtml(str: string) {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      }

      function showToast(message: string, type: "success" | "error" = "success") {
        if (!toast) return;
        toast.textContent = message;
        toast.className = `toast ${type} show`;
        setTimeout(() => toast.classList.remove("show"), 3000);
      }

      function buildRowHtml(ev: Event): string {
        return `<tr data-id="${ev.id}">
          <td><strong>${escapeHtml(ev.title)}</strong></td>
          <td>${escapeHtml(ev.start_date)}</td>
          <td>${ev.end_date ? escapeHtml(ev.end_date) : "—"}</td>
          <td>${escapeHtml(ev.group_name)}</td>
          <td>${escapeHtml(ev.created_by)}</td>
          <td class="notes">${escapeHtml(ev.notes || "")}</td>
          <td class="actions">
            <div class="menu">
              <button class="menu-trigger" type="button" aria-label="Open actions menu">⋯</button>
              <div class="menu-panel" hidden>
                <button class="edit" data-id="${ev.id}" type="button">Edit</button>
                <button class="delete" data-id="${ev.id}" type="button">Delete</button>
              </div>
            </div>
          </td>
        </tr>`;
      }

      function getFilteredEvents(): Event[] {
        if (!appState.search) return [...allEvents];
        const q = appState.search.toLowerCase();
        return allEvents.filter(
          ev => ev.title.toLowerCase().includes(q) || (ev.notes ?? "").toLowerCase().includes(q)
        );
      }

      function renderPagination(totalItems: number, page: number, ps: number) {
        const tp = Math.ceil(totalItems / ps) || 1;

        let html = '<button class="page-btn" data-page="' + (page - 1) + '"' + (page <= 1 ? " disabled" : "") + ' aria-label="Previous page">&laquo;</button>';

        const visiblePages: (number | "…")[] = [];
        for (let p = 1; p <= tp; p++) {
          if (tp <= 7 || p === 1 || p === tp || (p >= page - 1 && p <= page + 1)) {
            visiblePages.push(p);
          } else if (visiblePages[visiblePages.length - 1] !== "…") {
            visiblePages.push("…");
          }
        }

        for (const p of visiblePages) {
          if (p === "…") {
            html += '<span class="page-ellipsis">…</span>';
          } else {
            html += '<button class="page-btn' + (p === page ? " active" : "") + '" data-page="' + p + '">' + p + '</button>';
          }
        }

        html += '<button class="page-btn" data-page="' + (page + 1) + '"' + (page >= tp ? " disabled" : "") + ' aria-label="Next page">&raquo;</button>';

        paginationContainer.innerHTML = html;
      }

      function updateRangeInfo(totalItems: number, page: number, ps: number) {
        const rangeEl = document.querySelector(".range-info");
        if (!rangeEl) return;
        if (totalItems === 0) {
          rangeEl.textContent = "No results";
          return;
        }
        const start = (page - 1) * ps + 1;
        const end = Math.min(page * ps, totalItems);
        rangeEl.textContent = start + "–" + end + " of " + totalItems;
      }

      function renderTable() {
        const filtered = getFilteredEvents();
        const totalFiltered = filtered.length;
        const colCount = 7;
        const start = (appState.page - 1) * PAGE_SIZE;
        const pageEvents = filtered.slice(start, start + PAGE_SIZE);

        if (pageEvents.length === 0) {
          tbody.innerHTML = '<tr><td colspan="' + colCount + '" class="empty">' + (appState.search ? "No matching events" : "No events yet") + '</td></tr>';
        } else {
          tbody.innerHTML = pageEvents.map(buildRowHtml).join("");
        }

        updateRangeInfo(totalFiltered, appState.page, PAGE_SIZE);
        renderPagination(totalFiltered, appState.page, PAGE_SIZE);
      }

      // ── Dialog ───────────────────────────────────────────────
      function openAddDialog() {
        if (typeof addDialog.showModal !== "function") {
          showToast("Your browser does not support the dialog feature.", "error");
          return;
        }
        form.reset();
        const eventIdInput = form.querySelector('input[name="event_id"]') as HTMLInputElement | null;
        if (eventIdInput) eventIdInput.remove();
        const heading = addDialog.querySelector("h2");
        if (heading) heading.textContent = "Add Event";
        const saveBtn = form.querySelector(".save-btn") as HTMLButtonElement | null;
        if (saveBtn) saveBtn.textContent = "Add";
        addDialog.showModal();
      }

      function openEditDialog(ev: Event) {
        if (typeof addDialog.showModal !== "function") {
          showToast("Your browser does not support the dialog feature.", "error");
          return;
        }

        const heading = addDialog.querySelector("h2");
        if (heading) heading.textContent = "Edit Event";
        const saveBtn = form.querySelector(".save-btn") as HTMLButtonElement | null;
        if (saveBtn) saveBtn.textContent = "Save";

        let eventIdInput = form.querySelector('input[name="event_id"]') as HTMLInputElement | null;
        if (!eventIdInput) {
          eventIdInput = document.createElement("input");
          eventIdInput.type = "hidden";
          eventIdInput.name = "event_id";
          form.insertBefore(eventIdInput, form.firstChild);
        }
        eventIdInput.value = String(ev.id);

        const titleInput = form.querySelector("#title") as HTMLInputElement;
        if (titleInput) titleInput.value = ev.title;
        const startInput = form.querySelector("#start_date") as HTMLInputElement;
        if (startInput) startInput.value = ev.start_date;
        const endInput = form.querySelector("#end_date") as HTMLInputElement;
        if (endInput) endInput.value = ev.end_date ?? "";
        const groupInput = form.querySelector("#group_name") as HTMLInputElement;
        if (groupInput) groupInput.value = ev.group_name;
        const notesInput = form.querySelector("#notes") as HTMLTextAreaElement;
        if (notesInput) notesInput.value = ev.notes ?? "";

        addDialog.showModal();
      }

      function closeAddDialog() {
        if (typeof addDialog.close === "function") addDialog.close();
      }

      openAddButton.addEventListener("click", openAddDialog);
      closeDialogButton.addEventListener("click", closeAddDialog);
      cancelDialogButton.addEventListener("click", closeAddDialog);

      // ── Form Submit ──────────────────────────────────────────
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const body = Object.fromEntries(data.entries()) as Record<string, string>;
        const eventId = body.event_id;

        const now = new Date().toISOString();
        const eventData: Event = {
          id: eventId ? Number(eventId) : nextId++,
          title: body.title as string,
          start_date: body.start_date as string,
          end_date: (body.end_date as string) || null,
          notes: (body.notes as string) || null,
          group_name: (body.group_name as string) || "General",
          created_by: "demo",
          created_at: now,
        };

        if (eventId) {
          // Update
          const idx = allEvents.findIndex(ev => ev.id === Number(eventId));
          if (idx !== -1) {
            allEvents[idx] = eventData;
          }
          showToast("Event updated");
        } else {
          // Create
          allEvents.push(eventData);
          showToast("Event added");
        }

        saveEvents(allEvents);
        appState.eventsMap.set(eventData.id, eventData);

        closeAddDialog();
        form.reset();
        const eventIdInput = form.querySelector('input[name="event_id"]') as HTMLInputElement | null;
        if (eventIdInput) eventIdInput.remove();

        appState.page = 1;
        appState.search = "";
        if (searchInput) searchInput.value = "";
        renderTable();
      });

      // ── Search ───────────────────────────────────────────────
      if (searchInput) {
        searchInput.addEventListener("input", () => {
          clearTimeout(searchTimer);
          searchTimer = setTimeout(() => {
            appState.search = searchInput.value;
            appState.page = 1;
            renderTable();
          }, 300);
        });
      }

      // ── Pagination ───────────────────────────────────────────
      if (paginationContainer) {
        paginationContainer.addEventListener("click", (e) => {
          const btn = (e.target as HTMLElement).closest(".page-btn") as HTMLButtonElement | null;
          if (!btn || btn.disabled) return;
          const newPage = Number(btn.dataset.page);
          if (isNaN(newPage) || newPage < 1) return;
          appState.page = newPage;
          renderTable();
        });
      }

      // ── Menu & actions ───────────────────────────────────────
      function closeMenus() {
        document.querySelectorAll(".menu-panel").forEach((panel) => {
          (panel as HTMLElement).hidden = true;
        });
      }

      document.addEventListener("click", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target || !target.closest(".menu")) {
          closeMenus();
        }
      });

      tbody.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;

        if (!target.closest("td.actions")) return;

        if (target.classList.contains("menu-trigger")) {
          const panel = target.nextElementSibling as HTMLElement;
          const wasOpen = !panel.hidden;
          closeMenus();
          panel.hidden = wasOpen;
          return;
        }

        if (target.classList.contains("edit")) {
          closeMenus();
          const id = Number(target.dataset.id);
          const ev = allEvents.find(x => x.id === id);
          if (ev) openEditDialog(ev);
          return;
        }

        if (!target.classList.contains("delete")) return;
        const id = Number(target.dataset.id);
        const eventTitle = target.closest("tr")?.querySelector("strong")?.textContent?.trim() || "this event";

        if (!window.confirm('Delete "' + eventTitle + '"?')) return;

        allEvents = allEvents.filter(ev => ev.id !== id);
        saveEvents(allEvents);
        appState.eventsMap.delete(id);
        showToast("Event deleted");
        renderTable();
      });

      // ── Initial render ───────────────────────────────────────
      renderTable();
    </script>
  </body>
</html>
