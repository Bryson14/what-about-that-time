<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>What About That Time</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: system-ui, sans-serif;
        color: #1a1a1a;
        background: #fafafa;
        line-height: 1.6;
      }

      /* ── Hero ─────────────────────────────────────── */
      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 60vh;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
        color: #fff;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }

      .hero p {
        font-size: 1.2rem;
        color: #ccc;
        max-width: 480px;
        margin-bottom: 2rem;
      }

      .hero a {
        display: inline-block;
        padding: .75rem 2rem;
        background: #fff;
        color: #1a1a1a;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        transition: background 0.2s;
      }
      .hero a:hover { background: #e0e0e0; }

      /* ── Sections ─────────────────────────────────── */
      .section {
        padding: 4rem 2rem;
        max-width: 720px;
        margin: 0 auto;
      }

      .section + .section {
        border-top: 1px solid #eee;
      }

      .section h2 {
        font-size: 1.8rem;
        font-weight: 700;
        margin-bottom: 1rem;
      }

      .section p {
        color: #444;
        font-size: 1.05rem;
      }

      .access-note {
        margin-top: 1.25rem;
        padding: 1rem 1.25rem;
        background: #fff3cd;
        border-left: 4px solid #f0a500;
        border-radius: 4px;
        color: #5a3e00;
        font-size: .95rem;
      }
    </style>
  </head>
  <body>

    <!-- Hero -->
    <section class="hero">
      <h1>What About That Time</h1>
      <p>A personal timeline for tracking events, memories, and moments that matter.</p>
      <a href="/login">Sign In</a>
    </section>

    <!-- What is this -->
    <section class="section">
      <h2>What is this?</h2>
      <p>
        <strong>What About That Time</strong> is a simple personal app for logging events with dates
        and notes — so you always have an answer when someone asks, "what about that time when…?"
        Think of it as a lightweight private journal of moments, activities, and milestones,
        all sorted by date and easy to search.
      </p>
    </section>

    <!-- Who has access -->
    <section class="section">
      <h2>Who has access?</h2>
      <p>
        This app is private and built for exactly one person. If you're not the owner of this
        project… you don't have access, lol. 😄
      </p>
      <div class="access-note">
        🔒 Access is restricted to the project owner only. No sign-ups, no invites.
      </div>
    </section>

  </body>
</html>
