---
export const prerender = true;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="A personal timeline for tracking events, memories, and moments that matter. A private journal of moments, activities, and milestones." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <title>What About That Time</title>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: system-ui, sans-serif;
        color: #1a1a1a;
        background: #fafafa;
        line-height: 1.6;
      }

      /* ── Hero ─────────────────────────────────────── */
      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 60vh;
        padding: 3rem 1rem;
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
        color: #fff;
      }

      .hero h1 {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        margin-bottom: 1rem;
      }

      .hero p {
        font-size: 1rem;
        color: #ccc;
        max-width: 480px;
        margin-bottom: 1.5rem;
      }

      .hero a {
        display: inline-block;
        padding: .75rem 2rem;
        background: #fff;
        color: #1a1a1a;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 600;
        font-size: 1rem;
        transition: background 0.2s;
      }
      .hero a:hover { background: #e0e0e0; }

      /* ── Sections ─────────────────────────────────── */
      .section {
        padding: 2.5rem 1rem;
        max-width: 720px;
        margin: 0 auto;
      }

      .section + .section {
        border-top: 1px solid #eee;
      }

      .section h2 {
        font-size: 1.45rem;
        font-weight: 700;
        margin-bottom: 1rem;
      }

      .section p {
        color: #444;
        font-size: 1rem;
      }

      .access-note {
        margin-top: 1.25rem;
        padding: .9rem 1rem;
        background: #fff3cd;
        border-left: 4px solid #f0a500;
        border-radius: 4px;
        color: #5a3e00;
        font-size: .95rem;
      }

      @media (min-width: 768px) {
        .hero { padding: 4rem 2rem; }
        .hero p {
          font-size: 1.2rem;
          margin-bottom: 2rem;
        }
        .section { padding: 4rem 2rem; }
        .section h2 { font-size: 1.8rem; }
        .section p { font-size: 1.05rem; }
      }
    </style>
  </head>
  <body>

    <!-- Hero -->
    <section class="hero">
      <h1>What About That Time</h1>
      <p>A personal timeline for tracking events, memories, and moments that matter.</p>
      <a href="/login">Sign In</a>
    </section>

    <!-- What is this -->
    <section class="section">
      <h2>What is this?</h2>
      <p>
        <strong>What About That Time</strong> is a simple personal app for logging events with dates
        and notes — so you always have an answer when someone asks, "what about that time when…?"
        Think of it as a lightweight private journal of moments, activities, and milestones,
        all sorted by date and easy to search.
      </p>
    </section>

    <!-- Who has access -->
    <section class="section">
      <h2>Who has access?</h2>
      <p>
        This app is private and intended for family contributors invited by the owner.
        There are no public sign-ups.
      </p>
      <div class="access-note">
        🔒 Access is managed by the admin through the admin dashboard.
      </div>
    </section>

    <!-- Demo -->
    <section class="section">
      <h2>Try the demo</h2>
      <p>
        Want to see how it works without signing in? Explore the demo with a
        sample timeline of historical events. Everything runs in your browser
        using local storage — try adding, editing, and deleting events.
      </p>
      <p style="margin-top: 1rem;">
        <a href="/demo/app" style="color: #1a1a1a; font-weight: 600;">Open demo →</a>
      </p>
    </section>

  </body>
</html>
